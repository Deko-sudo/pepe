APP_ENV=development
APP_NAME=Pepe
APP_SLUG=pepe
APP_VERSION=0.1.0

# W3 isolated-wrapper contract defaults. Keep disabled outside local/test validation.
MARKET_DATA_MODE=demo
EMBEDDED_CHART_ENABLED=false
EMBEDDED_CHART_PROVIDER=none
EMBEDDED_CHART_WRAPPER_ORIGIN=
# Local/test-only validation example (do not enable in production):
# MARKET_DATA_MODE=embedded
# EMBEDDED_CHART_ENABLED=true
# EMBEDDED_CHART_PROVIDER=tradingview_isolated_wrapper
# EMBEDDED_CHART_WRAPPER_ORIGIN=http://127.0.0.1:4173

POSTGRES_DB=pepe
POSTGRES_USER=pepe
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://pepe:change_me@postgres:5432/pepe

REDIS_URL=redis://redis:6379/0

# Background-market-data queues. The Compose worker consumes celery, quotes and candles.
QUOTE_CACHE_URL=redis://redis:6379/1
QUOTE_FAKE_PROVIDER_ENABLED=true
QUOTE_QUEUE_NAME=quotes
QUOTE_SCHEDULER_INTERVAL_SECONDS=60
CANDLE_QUEUE_NAME=candles
CANDLE_SYNC_LEASE_TTL_SECONDS=300
CANDLE_SCHEDULER_INTERVAL_SECONDS=300
CANDLE_FAKE_PROVIDER_ENABLED=true

TELEGRAM_BOT_TOKEN=
MINI_APP_URL=http://localhost
MINI_APP_BUILD_ID=dev

TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
TELEGRAM_INIT_DATA_FUTURE_SKEW_SECONDS=30

API_HOST=0.0.0.0
API_PORT=8000

# Must include every SESSION_ALLOWED_ORIGINS value for credentialed browser requests.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:8080
SESSION_COOKIE_NAME=pepe_session
SESSION_ABSOLUTE_TTL_SECONDS=2592000
SESSION_IDLE_TTL_SECONDS=604800
SESSION_MAX_ACTIVE=5
# Local HTTP development only. Production must set this to true.
SESSION_COOKIE_SECURE=false
# Use none only with SESSION_COOKIE_SECURE=true for embedded Telegram Desktop WebViews.
SESSION_COOKIE_SAME_SITE=lax
# Requires SESSION_COOKIE_SAME_SITE=none and SESSION_COOKIE_SECURE=true.
SESSION_COOKIE_PARTITIONED=false
SESSION_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:8080
LOG_LEVEL=INFO

# ── External ports (Docker Compose) ──────────────────────────────
MINI_APP_PORT=4000
API_EXT_PORT=8100
POSTGRES_PORT=5433
REDIS_PORT=6380
CADDY_PORT=8080
